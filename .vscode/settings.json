{
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
  "todo-tree.general.tags": ["TODO", "FIXME", "PENDING-FRONTEND"],
  "todo-tree.highlights.defaultHighlight": {
    "icon": "alert",
    "type": "text",
    "foreground": "#e5c07b"
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "foreground": "#61afef"
    },
    "FIXME": {
      "icon": "flame",
      "foreground": "#e06c75"
    },
    "PENDING-FRONTEND": {
      "icon": "browser",
      "foreground": "#c678dd"
    }
  },
  "todo-tree.filtering.excludeGlobs": [
    "**/node_modules/**",
    "**/tmp/**",
    "**/log/**",
    "**/public/**",
    "**/coverage/**",
    "**/.git/**"
  ]
}
